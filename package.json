{
  "name": "@wingsky-1/dsh-xiaozhuge",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Xiaozhuge (小诸葛): agent team framework for DeepSeek Harness — MVP 阶段，不发布",
  "type": "module",
  "license": "MIT",
  "author": "wingsky-1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wingsky-1/xiaozhuge.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/build-client.mjs && node scripts/verify-client.mjs",
    "build:server": "tsc --project tsconfig.json",
    "build:client": "node scripts/build-client.mjs && node scripts/verify-client.mjs",
    "test": "vitest run",
    "cov": "vitest run --coverage",
    "cov:patch": "diff-cover coverage/cobertura-coverage.xml --compare-branch=origin/main --fail-under=80",
    "mutation": "node scripts/mutation-all.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "mutation:gate": "node scripts/mutation-gate.mjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "@xyflow/react": "12.11.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "external": [
        "react",
        "react/jsx-runtime",
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "write-file-atomic": "8.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
